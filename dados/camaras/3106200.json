h.mg.gov.br/vereadores/professora-marli","exercicio":null,"exercicio_en":null},{"id":"ver-3106200-130002222507","nome":"Professora Nara","nomeCivil":"Nara Lucia de Paula Fan","partido":"REDE","genero":"F","foto":"img/pessoas/ver-3106200-130002222507.jpg","url":"https://www.cmbh.mg.gov.br/vereadores/professora-nara","exercicio":"Suplente em exercício","exercicio_en":"Substitute in office"},{"id":"ver-3106200-130002033670","nome":"Rudson Paixão","nomeCivil":"Rudson Felipe da Paixão","partido":"SOLIDARIEDADE","genero":"M","foto":"img/pessoas/ver-3106200-130002033670.jpg","url":"https://www.cmbh.mg.gov.br/vereadores/rudson-paix%C3%A3o","exercicio":null,"exercicio_en":null},{"id":"ver-3106200-130002172742","nome":"Sargento Jalyson","nomeCivil":"Jalyson Maycon Goncalves","partido":"PL","genero":"M","foto":"img/pessoas/ver-3106200-130002172742.jpg","url":"https://www.cmbh.mg.gov.br/vereadores/sargento-jalyson","exercicio":null,"exercicio_en":null},{"id":"ver-3106200-130001998136","nome":"Tileléo","nomeCivil":"Leonardo José Rodrigues Martins","partido":"PP","genero":"M","foto":"img/pessoas/ver-3106200-130001998136.jpg","url":"https://www.cmbh.mg.gov.br/vereadores/tilel%C3%A9o","exercicio":null,"exercicio_en":null},{"id":"ver-3106200-130001976053","nome":"Trópia","nomeCivil":"Marcela de Lacerda Trópia","partido":"NOVO","genero":"F","foto":"img/pessoas/ver-3106200-130001976053.jpg","url":"https://www.cmbh.mg.gov.br/vereadores/tr%C3%B3pia","exercicio":null,"exercicio_en":null},{"id":"ver-3106200-130002172718","nome":"Uner Augusto","nomeCivil":"Uner Augusto de Carvalho Alvarenga","partido":"PL","genero":"M","foto":"img/pessoas/ver-3106200-130002172718.jpg","url":"https://www.cmbh.mg.gov.br/vereadores/uner-augusto-0","exercicio":null,"exercicio_en":null},{"id":"ver-3106200-130002172736","nome":"Vile Santos","nomeCivil":"Wili dos Santos","partido":"PL","genero":"M","foto":"img/pessoas/ver-3106200-130002172736.jpg","url":"https://www.cmbh.mg.gov.br/vereadores/vile-santos","exercicio":null,"exercicio_en":null},{"id":"ver-3106200-130002172510","nome":"Wagner Ferreira","nomeCivil":"Wagner de Jesus Ferreira","partido":"REDE","genero":"M","foto":"img/pessoas/ver-3106200-130002172510.jpg","url":"https://www.cmbh.mg.gov.br/vereadores/wagner-ferreira","exercicio":null,"exercicio_en":null},{"id":"ver-3106200-130001902236","nome":"Wanderley Porto","nomeCivil":"Wanderley de Araujo Porto Filho","partido":"PRD","genero":"M","foto":"img/pessoas/ver-3106200-130001902236.jpg","url":"https://www.cmbh.mg.gov.br/vereadores/wanderley-porto","exercicio":null,"exercicio_en":null}],"notas":["As propostas vêm da pesquisa de proposições do portal da Câmara (a lista e a página de cada proposição): o primeiro nome da autoria é o autor principal e os outros assinaram junto; a situação é a que a Câmara publica (\"Lei\", \"Primeiro turno\", \"Retirada\"...). Projetos da Mesa Diretora e das comissões não entram no perfil de nenhum vereador. O portal pede 10 segundos entre um pedido e outro; por isso, a situação de cada proposição é revista em até dez dias (as novas entram no mesmo dia).","As votações de cada vereador não entram neste site: a Câmara publica o voto de cada vereador num arquivo PDF por votação, sem dados abertos.","Gastos do mandato: a Câmara de Belo Horizonte extinguiu a verba indenizatória em 2015 (Resolução 2.076/2015); desde então, o material e os serviços dos gabinetes são contratados e pagos pela própria Câmara (o \"custeio parlamentar\", em páginas do portal da transparência)."],"notas_en":["Bills come from the bills search on the City Council's portal (the list and each bill's page): the first name among the authors is the main author and the others co-signed; the status is the one the City Council publishes (\"Law\", \"First round\", \"Withdrawn\"...). Bills by the City Council's board or committees are not shown on any councilor's profile. The portal asks for 10 seconds between requests, so each bill's status is checked again within ten days (new bills are added on the same day).","Each councilor's votes are not included on this site: the City Council publishes each councilor's vote in one PDF file per vote, with no open data.","Office spending: the Belo Horizonte City Council abolished its office allowance in 2015 (Resolution 2,076/2015); since then, the supplies and services of each office are bought and paid for by the City Council itself (shown on pages of its transparency portal)."],"atualizado":"2026-10-27"}
