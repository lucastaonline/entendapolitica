 not show the number of vetoes."]}},"atualizado":"2026-10-15","onde":{"camara":{"site":"https://www.campinaverde.mg.leg.br/","sistema":"sapl","api":"https://sapl.campinaverde.mg.leg.br/api/","propostas":"https://sapl.campinaverde.mg.leg.br/materia/pesquisar-materia","propostasOnline":true,"sic":"https://www.campinaverde.mg.leg.br/ouvidoria","conferido":"2026-10-26","motivo":null,"motivo_en":null},"prefeitura":{"site":"https://www.campinaverde.mg.gov.br/","transparencia":"http://pmcverde.horusdm.com.br/transparencia","sic":null,"diarioOficial":{"nome":"Diário Oficial do Município de Campina Verde","url":"http://campinaverde.mg.gov.br/diariooficial/","plataforma":"Própria (site oficial)"},"conferido":"2026-10-26"}}}
