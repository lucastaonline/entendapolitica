s.tse.jus.br/divulga/rest/arquivo/img/2045202024/170002104914/23590","genero":"M","votos":751,"situacao":"Eleito por QP","url":"https://sapl.cabrobo.pe.leg.br/parlamentar/2","extras":"cidade"},{"id":"ver-2603009-170002171571","nome":"Tinanan","nomeCivil":"Josete Pedro Xavier de Lima","partido":"AVANTE","foto":"https://divulgacandcontas.tse.jus.br/divulga/rest/arquivo/img/2045202024/170002171571/23590","genero":"M","votos":1257,"situacao":"Eleito por QP","url":"https://sapl.cabrobo.pe.leg.br/parlamentar/13","extras":"cidade"},{"id":"ver-2603009-170002016682","nome":"Wagner de Sarapó","nomeCivil":"Wagner Lira Marques","partido":"PSB","foto":"https://divulgacandcontas.tse.jus.br/divulga/rest/arquivo/img/2045202024/170002016682/23590","genero":"M","votos":787,"situacao":"Eleito por média","url":"https://sapl.cabrobo.pe.leg.br/parlamentar/3","extras":"cidade"}],"oficial":true,"infoCasa":{"casa":"Câmara Municipal de Cabrobó","casa_en":"Cabrobó City Council","sigla":"CMC","site":"https://cabrobo.pe.leg.br","cobertura":{"lista":true,"propostas":true,"votacoes":true,"gastos":false},"notas":["A Câmara não registra no SAPL o andamento da maior parte das propostas (140 de 207 apresentadas desde 1º/1/2025): a situação delas aparece como não registrada.","Os gastos do mandato de cada vereador não entram neste site: o sistema de dados abertos da Câmara (SAPL) não tem esse dado.","Faltam leis no SAPL desta Câmara (cerca de 52 dos 86 números de lei desde 1º/1/2025 não estão cadastrados, contando as que deveriam vir depois da última cadastrada, de 16/9/2026): o número de leis sancionadas fica fora do perfil do prefeito.","O SAPL desta Câmara não registra nenhum veto desde 1º/1/2025: como não dá para saber se não houve veto ou se ele não foi cadastrado, o perfil do prefeito não mostra o número de vetos."],"notas_en":["The City Council does not record in SAPL the progress of most bills (140 of 207 filed since January 1, 2025), so their status shows as not recorded.","Each councilor's office spending is not included on this site: the City Council's open data system (SAPL) does not have it.","Some laws are missing from this City Council's SAPL system (about 52 of the 86 law numbers since January 1, 2025 are not there, counting those that should have come after the last one recorded, from September 16, 2026), so the number of laws signed is left out of the mayor's profile.","This City Council's SAPL system records no veto since January 1, 2025. Since there is no way to tell whether there was no veto or it was not recorded, the mayor's profile does not show the number of vetoes."],"conferido":"2026-10-29"}},"atualizado":"2026-10-29","onde":{"camara":{"site":"https://sapl.cabrobo.pe.leg.br/","sistema":"sapl","api":"https://sapl.cabrobo.pe.leg.br/api/","propostas":"https://sapl.cabrobo.pe.leg.br/materia/pesquisar-materia","propostasOnline":true,"sic":null,"conferido":"2026-10-23","motivo":null,"motivo_en":null},"prefeitura":{"site":"https://cabrobo.pe.gov.br/","transparencia":"https://cabrobo.pe.gov.br/transparencia","sic":"https://www.cabrobo.pe.gov.br/transparencia/esic/","diarioOficial":null,"conferido":"2026-10-23"}}}
